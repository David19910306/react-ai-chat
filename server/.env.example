# 复制为 .env（生产环境）或 .env.development（开发环境），并填入真实值
PORT=3000
NODE_ENV=development

# mysql数据库配置
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=database

# token密钥：node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET=your_random_base64_secret

# openai配置（兼容 DeepSeek 等 OpenAI 兼容接口）
OPENAI_API_KEY=your_api_key
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_MODEL=deepseek-chat
